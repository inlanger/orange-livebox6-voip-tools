LIVEBOX_HOST=192.168.1.1
LIVEBOX_API_USER=UsrAdmin
LIVEBOX_API_PASSWORD=YOUR_WIFI_KEY_FROM_STICKER

ORANGE_PHONE_NUMBER=+34960000000
ORANGE_SIP_URI=+34960000000@sip.orange.es
ORANGE_SIP_USERNAME=YOUR_AUTH_USERNAME@sip.orange.es
ORANGE_SIP_PASSWORD=YOUR_AUTH_PASSWORD

ORANGE_SIP_DOMAIN=sip.orange.es
ORANGE_SIP_PROXY_HOST=proxy2.sip.orange.es
ORANGE_SIP_PROXY_PORT=5060
ORANGE_SIP_OUTBOUND_PROXY_HOST=85.62.240.173
ORANGE_SIP_OUTBOUND_PROXY_LIST=85.62.240.173,85.62.244.113
ORANGE_SIP_REGISTER_EXPIRES=3600

# SIP bridge: the server receiving incoming calls.
ORANGE_PROXY_UPSTREAM_HOST=127.0.0.1
ORANGE_PROXY_UPSTREAM_PORT=5060
# Listener for calls from that server; restrict access with your firewall.
ORANGE_PROXY_BIND_HOST=0.0.0.0
ORANGE_PROXY_BIND_PORT=5064
ORANGE_PROXY_DOWNSTREAM_PORT=5070
ORANGE_PROXY_TRACE_SIP=false
